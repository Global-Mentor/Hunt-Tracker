<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:local="clr-namespace:HuntTracker.Desktop" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="HuntTracker.Desktop.MainWindow" Style="{StaticResource {x:Type Window}}" Icon="/HuntTracker;component/assets/app-icon.ico" Title="Hunt Tracker (by Global Mentor)" Width="1020" Height="820" MinWidth="820" MinHeight="600" WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
  <Grid>
    <Grid Margin="24,18,24,22">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid Margin="0,0,0,6">
        <TextBlock Text="Hunt Tracker" FontFamily="Cambria" FontSize="28" HorizontalAlignment="Center" Foreground="White" />
      </Grid>
      <Button Grid.Row="1" Command="{Binding ShowSettingsCommand}" Style="{StaticResource ConnectionButton}" HorizontalAlignment="Center" Margin="0,0,0,6" ToolTip="Открыть настройки подключения" AutomationProperties.Name="Состояние подключения">
        <StackPanel Orientation="Horizontal">
          <Ellipse Fill="{Binding ConnectionColor}" Width="6" Height="6" Margin="0,0,8,0" />
          <TextBlock Text="{Binding ConnectionStatus}" Foreground="{Binding ConnectionColor}" FontSize="13" />
        </StackPanel>
      </Button>
      <TabControl Grid.Row="2" SelectedIndex="{Binding SelectedTab}" KeyboardNavigation.TabNavigation="Continue">
        <TabItem Header="СЕССИЯ">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,2,0">
            <StackPanel Margin="0,22,0,0">
              <DockPanel Margin="0,0,12,18">
                <Button DockPanel.Dock="Right" Content="Новая сессия" Command="{Binding NewSessionCommand}" ToolTip="Сохраняет текущую сессию в истории и начинает новые счётчики." Style="{StaticResource PrimaryButton}" />
                <TextBlock Text="{Binding SessionTitle}" VerticalAlignment="Center" FontSize="20" Foreground="{StaticResource TextBrush}" FontFamily="Cambria" />
              </DockPanel>
              <UniformGrid Columns="4">
                <local:HuntPanel Style="{StaticResource Card}" Padding="10,18">
                  <StackPanel HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                      <Path Width="18" Height="21" Margin="0,0,8,0" Stretch="Uniform" Data="{StaticResource StatisticsSkull}" Fill="White" />
                      <TextBlock Text="Убийства" FontFamily="Cambria" FontSize="20" HorizontalAlignment="Center" Foreground="#B7B6AF" />
                    </StackPanel>
                    <TextBlock Text="{Binding Stats.Kills}" FontFamily="Bahnschrift" FontSize="36" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" Margin="0,10,0,0" Height="46" VerticalAlignment="Center" />
                  </StackPanel>
                </local:HuntPanel>
                <local:HuntPanel Style="{StaticResource Card}" Padding="10,18">
                  <StackPanel HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                      <Path Width="18" Height="21" Margin="0,0,8,0" Stretch="Uniform" Data="{StaticResource StatisticsSkull}" Fill="#D98D80" />
                      <TextBlock Text="Смерти" FontFamily="Cambria" FontSize="20" HorizontalAlignment="Center" Foreground="#B7B6AF" />
                    </StackPanel>
                    <TextBlock Text="{Binding Stats.Deaths}" FontFamily="Bahnschrift" FontSize="36" Foreground="{StaticResource DeathBrush}" HorizontalAlignment="Center" Margin="0,10,0,0" Height="46" VerticalAlignment="Center" />
                  </StackPanel>
                </local:HuntPanel>
                <local:HuntPanel Style="{StaticResource Card}" Padding="10,18">
                  <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="K/D" FontFamily="Cambria" FontSize="20" HorizontalAlignment="Center" Foreground="#B7B6AF" />
                    <TextBlock Text="{Binding Stats.Kd}" FontFamily="Bahnschrift" FontSize="36" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" Margin="0,10,0,0" Height="46" VerticalAlignment="Center" />
                  </StackPanel>
                </local:HuntPanel>
                <local:HuntPanel Style="{StaticResource Card}" Padding="10,18">
                  <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Матчи" FontFamily="Cambria" FontSize="20" HorizontalAlignment="Center" Foreground="#B7B6AF" />
                    <TextBlock Text="{Binding Stats.Games}" FontFamily="Bahnschrift" FontSize="36" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" Margin="0,10,0,0" Height="46" VerticalAlignment="Center" />
                  </StackPanel>
                </local:HuntPanel>
              </UniformGrid>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <local:HuntPanel Padding="20" Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="Итоги сессии" Style="{StaticResource Heading}" Margin="0,0,0,18" />
                    <Image Source="{StaticResource DividerTexture}" Stretch="Fill" Height="8" Margin="0,0,0,18" Opacity="0.5" />
                    <DockPanel Margin="0,0,0,14">
                      <TextBlock DockPanel.Dock="Right" Text="{Binding Stats.Survived}" FontSize="18" Foreground="{StaticResource TextBrush}" />
                      <TextBlock Text="Выжили" FontSize="18" Foreground="{StaticResource MutedBrush}" />
                    </DockPanel>
                    <DockPanel Margin="0,0,0,14">
                      <TextBlock DockPanel.Dock="Right" Text="{Binding Stats.Lost}" FontSize="18" Foreground="{StaticResource TextBrush}" />
                      <TextBlock Text="Не выжили" FontSize="18" Foreground="{StaticResource MutedBrush}" />
                    </DockPanel>
                    <DockPanel Margin="0,0,0,14">
                      <TextBlock DockPanel.Dock="Right" Text="{Binding Stats.Trades}" FontSize="18" Foreground="{StaticResource TextBrush}" />
                      <TextBlock Text="Размены" FontSize="18" Foreground="{StaticResource MutedBrush}" />
                    </DockPanel>
                    <DockPanel Margin="0,0,0,14">
                      <TextBlock DockPanel.Dock="Right" Text="{Binding Stats.Survival}" FontSize="18" Foreground="{StaticResource GoldBrush}" />
                      <TextBlock Text="Выживаемость" FontSize="18" Foreground="{StaticResource MutedBrush}" />
                    </DockPanel>
                  </StackPanel>
                </local:HuntPanel>
                <local:HuntPanel Grid.Column="1" Padding="20" Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="{Binding MatchHeading}" Style="{StaticResource Heading}" Margin="0,0,0,18" />
                    <Image Source="{StaticResource DividerTexture}" Stretch="Fill" Height="8" Margin="0,0,0,18" Opacity="0.5" />
                    <StackPanel Visibility="{Binding HasCurrentMatch, Converter={StaticResource BoolVisibility}}">
                      <TextBlock Text="{Binding CurrentMap}" FontSize="17" Margin="0,0,0,16" />
                      <TextBlock Text="{Binding CurrentStatus}" Foreground="{Binding CurrentColor}" Margin="0,0,0,16" FontSize="17" />
                      <TextBlock Text="{Binding CurrentKills}" Margin="0,0,0,16" FontSize="17" />
                      <TextBlock Text="{Binding CurrentDeaths}" Margin="0,0,0,16" FontSize="17" />
                    </StackPanel>
                    <TextBlock Text="Матчей пока нет. Статистика появится после начала игры.">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding HasCurrentMatch}" Value="False">
                              <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </StackPanel>
                </local:HuntPanel>
              </Grid>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="ИСТОРИЯ">
          <Grid Margin="0,22,0,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition />
            </Grid.RowDefinitions>
            <Grid Grid.Row="1">
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="158" />
              </Grid.ColumnDefinitions>
              <UniformGrid Columns="5">
                <Border Padding="12,8" Margin="0,0,0,14" BorderBrush="#444640" BorderThickness="0,0,0,1">
                  <StackPanel>
                    <TextBlock Text="Убийства" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock Text="{Binding HistoryStats.Kills}" FontSize="22" Margin="0,8,0,0" />
                  </StackPanel>
                </Border>
                <Border Padding="12,8" Margin="0,0,0,14" BorderBrush="#444640" BorderThickness="0,0,0,1">
                  <StackPanel>
                    <TextBlock Text="Смерти" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock Text="{Binding HistoryStats.Deaths}" FontSize="22" Margin="0,8,0,0" />
                  </StackPanel>
                </Border>
                <Border Padding="12,8" Margin="0,0,0,14" BorderBrush="#444640" BorderThickness="0,0,0,1">
                  <StackPanel>
                    <TextBlock Text="K/D" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock Text="{Binding HistoryStats.Kd}" FontSize="22" Margin="0,8,0,0" />
                  </StackPanel>
                </Border>
                <Border Padding="12,8" Margin="0,0,0,14" BorderBrush="#444640" BorderThickness="0,0,0,1">
                  <StackPanel>
                    <TextBlock Text="Матчи" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock Text="{Binding HistoryStats.Games}" FontSize="22" Margin="0,8,0,0" />
                  </StackPanel>
                </Border>
                <Border Padding="12,8" Margin="0,0,0,14" BorderBrush="#444640" BorderThickness="0,0,0,1">
                  <StackPanel>
                    <TextBlock Text="Выживаемость" Foreground="{StaticResource MutedBrush}" FontSize="13" />
                    <TextBlock Text="{Binding HistoryStats.Survival}" FontSize="22" Margin="0,8,0,0" />
                  </StackPanel>
                </Border>
              </UniformGrid>
              <Border Grid.Column="1" BorderBrush="#444640" BorderThickness="1" Padding="12,8" Margin="10,0,0,14">
                <StackPanel>
                  <DockPanel Margin="0,2">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding HistoryStats.Survived}" FontSize="13" />
                    <TextBlock Text="Выжили" Foreground="{StaticResource MutedBrush}" FontSize="13" />
                  </DockPanel>
                  <DockPanel Margin="0,2">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding HistoryStats.Lost}" FontSize="13" />
                    <TextBlock Text="Не выжили" Foreground="{StaticResource MutedBrush}" FontSize="13" />
                  </DockPanel>
                  <DockPanel Margin="0,2">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding HistoryStats.Trades}" FontSize="13" />
                    <TextBlock Text="Размены" Foreground="{StaticResource MutedBrush}" FontSize="13" />
                  </DockPanel>
                </StackPanel>
              </Border>
            </Grid>
            <DockPanel Margin="0,0,0,18">
              <Button DockPanel.Dock="Right" Content="Текущая" Command="{Binding CurrentSessionCommand}" Margin="12,0,0,0" ToolTip="Вернуться к текущей сессии" />
              <TextBlock Text="Сессия" VerticalAlignment="Center" Margin="0,0,18,0" />
              <ComboBox ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}" DisplayMemberPath="Label" AutomationProperties.Name="Сессия истории" />
            </DockPanel>
            <DockPanel Grid.Row="2" Margin="0,0,0,12">
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Назад" Command="{Binding PreviousPageCommand}" Margin="0,0,10,0" />
                <TextBlock Text="{Binding HistoryPageLabel}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <Button Content="Далее" Command="{Binding NextPageCommand}" />
              </StackPanel>
              <TextBlock Text="{Binding HistoryNote}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
            </DockPanel>
            <Grid Grid.Row="3">
              <DataGrid ItemsSource="{Binding Matches}" Sorting="OnHistorySorting" AutomationProperties.Name="Матчи выбранной сессии" x:Name="HistoryTable">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="№ игры" Binding="{Binding Number}" Width="85" ElementStyle="{StaticResource CenteredCell}" />
                  <DataGridTextColumn Header="Карта" Binding="{Binding MapName}" Width="*" HeaderStyle="{StaticResource MapHeader}" />
                  <DataGridTextColumn Header="Убийства" Binding="{Binding Kills}" Width="95" ElementStyle="{StaticResource CenteredCell}" />
                  <DataGridTextColumn Header="Смерти" Binding="{Binding Deaths}" Width="90" ElementStyle="{StaticResource CenteredCell}" />
                  <DataGridTextColumn Header="Исход (оценка)" Binding="{Binding Result}" Width="145" ElementStyle="{StaticResource CenteredCell}" />
                  <DataGridTextColumn Header="Начало" Binding="{Binding Started, StringFormat=dd.MM HH:mm:ss}" Width="155" SortMemberPath="Started" ElementStyle="{StaticResource CenteredCell}" />
                </DataGrid.Columns>
              </DataGrid>
              <Border Background="#151616" Padding="24" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <Border.Style>
                  <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                          <Condition Binding="{Binding Matches.Count}" Value="0" />
                          <Condition Binding="{Binding IsHistoryLoading}" Value="False" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Visibility" Value="Visible" />
                      </MultiDataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <TextBlock Text="В этой сессии ещё нет матчей." HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
              </Border>
              <Border Background="#E6151616" Visibility="{Binding IsHistoryLoading, Converter={StaticResource BoolVisibility}}">
                <TextBlock Text="Загрузка истории…" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </Grid>
          </Grid>
        </TabItem>
        <TabItem Header="АЛЕРТЫ">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,2,0">
            <StackPanel Margin="0,20,0,0">
              <DockPanel LastChildFill="True">
                <Border Background="#202321" BorderBrush="#55594F" BorderThickness="1" Padding="12,0" Margin="0,0,16,18" VerticalAlignment="Top" DockPanel.Dock="Left" Width="224" Height="50">
                  <CheckBox IsChecked="{Binding AlertsEnabled}" Margin="0" ToolTip="Отключает только вывод. Сбор статистики продолжается." VerticalAlignment="Center">
                    <CheckBox.Style>
                      <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                        <Setter Property="Content" Value="Алерты включены" />
                        <Style.Triggers>
                          <Trigger Property="IsChecked" Value="False">
                            <Setter Property="Content" Value="Алерты выключены" />
                            <Setter Property="Foreground" Value="{StaticResource DeathBrush}" />
                          </Trigger>
                        </Style.Triggers>
                      </Style>
                    </CheckBox.Style>
                  </CheckBox>
                </Border>
                <Expander Header="Подключение к OBS" Margin="0,0,12,18" IsExpanded="False">
                  <StackPanel>
                    <TextBlock Text="В OBS добавьте источник «Браузер» → «Локальный файл». Размер: 160 × 120. Для звука включите «Управлять звуком через OBS»." Style="{StaticResource Hint}" />
                    <DockPanel Margin="0,0,0,0">
                      <Button DockPanel.Dock="Right" Content="Копировать путь" Command="{Binding CopyOverlayPathCommand}" CommandParameter="Overlay.html" Margin="10,0,0,0" />
                      <TextBox Text="{Binding AlertFile, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="14" AutomationProperties.Name="Файл алертов для OBS" VerticalContentAlignment="Center" Height="42" ToolTip="{Binding AlertFile}" />
                    </DockPanel>
                  </StackPanel>
                </Expander>
              </DockPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="1.15*" />
                  <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <local:HuntPanel Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="События и задержка" Style="{StaticResource Section}" />
                    <ComboBox x:Name="AlertMode" ItemsSource="{Binding AlertChoices}" SelectedIndex="{Binding AlertIndex}" AutomationProperties.Name="События алертов" />
                    <TextBlock Text="{Binding DelayText}" Foreground="{StaticResource GoldBrush}" Margin="0,12,0,0" />
                    <TextBlock Text="{Binding AlertExplanation}" Style="{StaticResource Hint}" />
                    <TextBlock Text="{Binding VolumeLabel}" Margin="0,6,0,4" />
                    <Slider x:Name="AlertVolume" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Volume}" AutomationProperties.Name="Громкость алерта" ToolTip="Громкость всех алертов. При нуле звук отключён." />
                    <TextBlock Text="{Binding DurationLabel}" Margin="0,18,0,4" />
                    <Slider Minimum="300" Maximum="10000" TickFrequency="100" IsSnapToTickEnabled="True" Value="{Binding Duration}" SmallChange="100" LargeChange="500" AutomationProperties.Name="Длительность отображения картинки" ToolTip="От 0,3 до 10 секунд. Стрелки клавиатуры меняют значение на 0,1 секунды." />
                  </StackPanel>
                </local:HuntPanel>
                <local:HuntPanel Grid.Column="1" Style="{StaticResource Card}">
                  <StackPanel>
                    <Button Content="Открыть виджет алертов" Command="{Binding OpenOverlayCommand}" CommandParameter="Overlay.html" Margin="0,0,0,22" Style="{StaticResource PrimaryButton}" />
                    <TextBlock Text="Тестовые события" Style="{StaticResource Section}" />
                    <TextBlock Text="Откройте виджет и выберите событие. Проверка работает при любом режиме и не меняет статистику." Style="{StaticResource Hint}" />
                    <Button Content="Тест: убийство" Command="{Binding TestCommand}" CommandParameter="kill" Margin="0,0,0,8" />
                    <Button Content="Тест: смерть" Command="{Binding TestCommand}" CommandParameter="death" Margin="0,0,0,8" />
                    <Button Content="Тест: размен" Command="{Binding TestCommand}" CommandParameter="trade" />
                  </StackPanel>
                </local:HuntPanel>
              </Grid>
              <Expander Header="Изображения и звуки" Margin="0,0,12,18">
                <StackPanel>
                  <TextBlock Text="Добавляйте PNG и аудиофайлы в папки kill, death и trade. Если файлов несколько, они выбираются случайно." Style="{StaticResource Hint}" />
                  <StackPanel Margin="0,0,0,14">
                    <Grid Margin="0,0,0,8">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="Событие" Foreground="{StaticResource MutedBrush}" />
                      <TextBlock Grid.Column="1" Text="Изображения" TextAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                      <TextBlock Grid.Column="2" Text="Звуки" TextAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding MediaRows}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border BorderBrush="#383C37" BorderThickness="0,1,0,0" Padding="0,8">
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                              </Grid.ColumnDefinitions>
                              <TextBlock Text="{Binding Label}" />
                              <TextBlock Grid.Column="1" Text="{Binding Images}" TextAlignment="Center" />
                              <TextBlock Grid.Column="2" Text="{Binding Sounds}" TextAlignment="Center" />
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                  <WrapPanel>
                    <Button Content="Папка изображений" Command="{Binding OpenMediaFolderCommand}" CommandParameter="images" Margin="0,0,10,8" />
                    <Button Content="Папка звуков" Command="{Binding OpenMediaFolderCommand}" CommandParameter="sounds" Margin="0,0,10,8" />
                    <Button Content="Обновить список" Command="{Binding RefreshMediaCommand}" Margin="0,0,0,8" />
                  </WrapPanel>
                  <CheckBox Content="Обновлять список автоматически" IsChecked="{Binding AutoRefreshMedia}" ToolTip="Проверяет папки раз в 2 секунды при включённых алертах." />
                </StackPanel>
              </Expander>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="ВИДЖЕТ OBS">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,2,0">
            <StackPanel Margin="0,20,0,0">
              <DockPanel LastChildFill="True">
                <Border Background="#202321" BorderBrush="#55594F" BorderThickness="1" Padding="12,0" Margin="0,0,16,18" VerticalAlignment="Top" DockPanel.Dock="Left" Width="224" Height="50">
                  <CheckBox IsChecked="{Binding StatisticsEnabled}" Margin="0" ToolTip="Отключает только вывод. Сбор статистики продолжается." VerticalAlignment="Center">
                    <CheckBox.Style>
                      <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                        <Setter Property="Content" Value="Виджет включён" />
                        <Style.Triggers>
                          <Trigger Property="IsChecked" Value="False">
                            <Setter Property="Content" Value="Виджет выключен" />
                            <Setter Property="Foreground" Value="{StaticResource DeathBrush}" />
                          </Trigger>
                        </Style.Triggers>
                      </Style>
                    </CheckBox.Style>
                  </CheckBox>
                </Border>
                <Expander Header="Подключение к OBS" IsExpanded="True" Margin="0,0,12,18">
                  <StackPanel>
                    <TextBlock Text="В OBS добавьте источник «Браузер» → «Локальный файл». Размер: 240 × 600. Для алертов используйте отдельный источник." Style="{StaticResource Hint}" />
                    <DockPanel Margin="0,0,0,0">
                      <Button DockPanel.Dock="Right" Content="Копировать путь" Command="{Binding CopyOverlayPathCommand}" CommandParameter="Statistics.html" Margin="10,0,0,0" />
                      <TextBox Text="{Binding StatisticsFile, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="14" AutomationProperties.Name="Файл статистики для OBS" VerticalContentAlignment="Center" Height="42" ToolTip="{Binding StatisticsFile}" />
                    </DockPanel>
                  </StackPanel>
                </Expander>
              </DockPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <local:HuntPanel Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="Что показывать" Style="{StaticResource Section}" />
                    <TextBlock Text="Скрытые поля продолжают считаться. Выбор меняет только виджет OBS." Style="{StaticResource Hint}" />
                    <ItemsControl ItemsSource="{Binding Fields}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <UniformGrid Columns="2" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <CheckBox Content="{Binding Label}" IsChecked="{Binding Selected}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </local:HuntPanel>
                <local:HuntPanel Grid.Column="1" Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="Внешний вид и обновление" Style="{StaticResource Section}" />
                    <TextBlock Text="{Binding OpacityLabel}" Margin="0,8,0,6" />
                    <Slider Value="{Binding Opacity}" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" AutomationProperties.Name="Непрозрачность фона" />
                    <TextBlock Text="Частота обновления виджета" Margin="0,20,0,8" />
                    <ComboBox ItemsSource="{Binding RefreshChoices}" SelectedIndex="{Binding RefreshIndex}" AutomationProperties.Name="Частота обновления виджета" />
                    <TextBlock Text="На задержку алертов эта настройка не влияет." Style="{StaticResource Hint}" />
                    <Button Content="Открыть виджет статистики" Command="{Binding OpenOverlayCommand}" CommandParameter="Statistics.html" Margin="0,8,0,0" />
                  </StackPanel>
                </local:HuntPanel>
              </Grid>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="НАСТРОЙКИ">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,2,0">
            <StackPanel Margin="0,20,12,0">
              <UniformGrid Columns="3" Margin="0,0,0,6">
                <local:HuntPanel Style="{StaticResource Card}" Padding="16">
                  <StackPanel>
                    <TextBlock Text="Hunt: Showdown" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,10" />
                    <TextBlock Text="{Binding GameStatus}" Foreground="{Binding GameStatusColor}" FontSize="18" />
                  </StackPanel>
                </local:HuntPanel>
                <local:HuntPanel Style="{StaticResource Card}" Padding="16">
                  <StackPanel>
                    <TextBlock Text="Game.log" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,10" />
                    <TextBlock Text="{Binding GameLogStatus}" Foreground="{Binding GameLogStatusColor}" FontSize="18" />
                  </StackPanel>
                </local:HuntPanel>
                <local:HuntPanel Style="{StaticResource Card}" Padding="16">
                  <StackPanel>
                    <TextBlock Text="NVIDIA Highlights" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,10" />
                    <TextBlock Text="{Binding NvidiaStatus}" Foreground="{Binding NvidiaStatusColor}" FontSize="18" />
                    <TextBlock Text="{Binding NvidiaStatusHint}" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" />
                  </StackPanel>
                </local:HuntPanel>
              </UniformGrid>
              <DockPanel Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Content="Применить пути" Command="{Binding SavePathsCommand}" IsEnabled="{Binding PathsChanged}" Style="{StaticResource PrimaryButton}" Margin="20,0,0,0" />
                <TextBlock Text="Подключение к игре" Style="{StaticResource Heading}" Margin="0" VerticalAlignment="Center" />
              </DockPanel>
              <TextBlock Text="AUTO находит Hunt в библиотеках Steam. Если игра не найдена, выберите её папку вручную." Style="{StaticResource Hint}" />
              <TextBlock Text="Папка игры" Margin="0,0,0,8" />
              <DockPanel>
                <Button DockPanel.Dock="Right" Content="Выбрать папку…" Command="{Binding BrowseFolderCommand}" CommandParameter="game" Margin="10,0,0,0" />
                <Button DockPanel.Dock="Right" Content="Авто" Command="{Binding AutoGameFolderCommand}" Margin="10,0,0,0" ToolTip="Вернуть автоматический поиск папки игры" />
                <TextBox Text="{Binding GameFolder, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Папка игры" />
              </DockPanel>
              <TextBlock Text="Папка логов NVIDIA Highlights" Margin="0,18,0,8" />
              <DockPanel>
                <Button DockPanel.Dock="Right" Content="Выбрать папку…" Command="{Binding BrowseFolderCommand}" CommandParameter="nvidia" Margin="10,0,0,0" />
                <TextBox Text="{Binding NvidiaFolder, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Папка NVIDIA" />
              </DockPanel>
              <DockPanel Margin="0,12,0,18">
                <TextBlock Text="После изменения папок нажмите «Применить пути». Чтение начнётся с конца новых файлов, сессия сохранится. Остальные настройки сохраняются автоматически." Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0" />
              </DockPanel>
              <Expander Header="Пути к логам" IsExpanded="False" Margin="0,0,0,12">
                <TextBox Text="{Binding LogStatus, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" BorderThickness="0" AutomationProperties.Name="Состояние и пути логов" VerticalContentAlignment="Top" />
              </Expander>
              <Expander Header="Сбор и диагностика" Margin="0,0,0,12">
                <StackPanel>
                  <CheckBox Content="Распознавать размены в статистике" IsChecked="{Binding DetectTrades}" />
                  <TextBlock Text="Экспериментальная оценка с окном 500 мс. Возможны ошибки. Работает независимо от режима алертов." Style="{StaticResource Hint}" />
                  <CheckBox Content="Подробная диагностика" IsChecked="{Binding DetailedDiagnostics}" />
                  <TextBlock Text="Для разбора пропущенных или неверно определённых событий. Записывает в журнал исходные сигналы NVIDIA и появление экрана смерти. Обычно можно оставить выключенной." Style="{StaticResource Hint}" />
                  <Button Content="Сохранить журнал для проверки" Command="{Binding ExportCommand}" HorizontalAlignment="Left" Margin="0,12,0,8" />
                  <TextBlock Text="Создаёт текстовый файл в папке logs с событиями и ошибками текущего запуска. Его можно открыть в Блокноте и использовать для поиска причины сбоя. Игровая статистика не меняется." Style="{StaticResource Hint}" />
                </StackPanel>
              </Expander>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
      </TabControl>
      <Border Grid.Row="3" Background="#202321" BorderBrush="#53574F" BorderThickness="1" Padding="14,10" Margin="0,12,0,0" MinHeight="42">
        <TextBlock Text="{Binding Status}" AutomationProperties.LiveSetting="Polite" HorizontalAlignment="Stretch" Margin="0" FontSize="13" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" MinHeight="18" VerticalAlignment="Center">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding HasStatusError}" Value="True">
                  <Setter Property="Foreground" Value="{StaticResource DeathBrush}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </Border>
    </Grid>
  </Grid>
</Window>
