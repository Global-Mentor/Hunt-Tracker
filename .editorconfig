root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,xaml,csproj,props,slnx}]
indent_size = 2

[*.cs]
csharp_preserve_single_line_statements = false
csharp_preserve_single_line_blocks = false

[*.{ps1,bat}]
end_of_line = crlf

[*.ps1]
charset = utf-8-bom
